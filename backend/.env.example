NODE_ENV=development
PORT=8080

# QR provider: wwebjs (default) or whaileys
WHATSAPP_PROVIDER=wwebjs
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_BIN=/usr/bin/chromium
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-accelerated-2d-canvas --no-first-run --no-zygote --disable-gpu

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=techkepper_command_center
DB_USER=root
DB_PASS=

# Use independent random values with at least 32 characters in production.
JWT_SECRET=replace-with-a-random-32-character-secret
JWT_REFRESH_SECRET=replace-with-another-random-32-character-secret
JWT_ISSUER=techkepper-command-center
JWT_AUDIENCE=techkepper-web
COOKIE_SECURE=false
TRUST_PROXY=false

# URLs. FRONTEND_URL accepts a comma-separated allowlist.
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost:3000
PROXY_PORT=8080

# Optional Redis persistence used by providers that support it.
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=2

# Secure guided administrator seed. Leave unset to create no default user.
INITIAL_ADMIN_NAME=Administrador Techkepper
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Initial business settings used by the Techkepper seeder.
COMPANY_NAME=Techkepper
COMPANY_EMAIL=ventas@techkeppercr.com
COMPANY_PHONE=+506 72259973
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true

LOG_LEVEL=info
WHAILEYS_LOG_LEVEL=error
SENTRY_DSN=
