NODE_ENV=development
PORT=8080

# Official WhatsApp Cloud API. Keep credentials only in server-side secrets.
WHATSAPP_PROVIDER=cloudapi
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account (WABA) ID, shown in Meta > WhatsApp > API Setup.
# Used to auto-subscribe the app to the WABA on startup (subscribed_apps);
# without that subscription Meta does not deliver inbound messages.
META_WHATSAPP_WABA_ID=
META_WHATSAPP_GRAPH_API_VERSION=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=techkepper_command_center
DB_USER=root
DB_PASS=

# Use independent random values with at least 32 characters in production.
JWT_SECRET=replace-with-a-random-32-character-secret
JWT_REFRESH_SECRET=replace-with-another-random-32-character-secret
JWT_ISSUER=techkepper-command-center
JWT_AUDIENCE=techkepper-web
COOKIE_SECURE=false
TRUST_PROXY=false

# URLs. FRONTEND_URL accepts a comma-separated allowlist.
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost:3000
PROXY_PORT=8080

# Secure guided administrator seed. Leave unset to create no default user.
INITIAL_ADMIN_NAME=Administrador Techkepper
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Initial business settings used by the Techkepper seeder.
COMPANY_NAME=Techkepper
COMPANY_EMAIL=ventas@techkeppercr.com
COMPANY_PHONE=+506 72259973
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true

LOG_LEVEL=info
SENTRY_DSN=

# External document storage: Dropbox App Folder, configured server-side only.
DROPBOX_STORAGE_ENABLED=false
DROPBOX_STORAGE_MODE=env
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_REDIRECT_URI=http://localhost:8081/dropbox/oauth/callback
DROPBOX_SYNC_RETRY_INTERVAL_MINUTES=5

# General reversible-encryption key. Dropbox env mode does not persist its token.
ENCRYPTION_KEY=replace-with-a-random-32-character-secret
