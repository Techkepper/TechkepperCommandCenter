# =============================================================================
# Heroku — copie este archivo como .env.production en la raíz del proyecto.
# No commitee .env.production: contiene secretos y credenciales.
#
# Deploy:
#   Local:  HEROKU_API_KEY=... ./scripts/heroku-deploy.sh
#   CI:     secrets HEROKU_API_KEY + ENV_PRODUCTION (contenido de .env.production)
# =============================================================================

# --- Base de datos (Site4Now / MySQL 8.x) ---
DB_HOST=MYSQL5044.site4now.net
DB_PORT=3306
DB_NAME=db_aa7e7f_command
DB_USER=aa7e7f_command
DB_PASS=YOUR_DB_PASSWORD
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DATABASE_URL=

# --- URLs Heroku ---
PUBLIC_BACKEND_URL=https://api-command-center.herokuapp.com
FRONTEND_URL=https://web-command-center.herokuapp.com
CORS_ALLOWED_ORIGINS=https://web-command-center.herokuapp.com

# --- Frontend (build Heroku) ---
VITE_BACKEND_URL=https://api-command-center.herokuapp.com

# --- JWT / cookies ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=techkepper-command-center
JWT_AUDIENCE=techkepper-web
COOKIE_SECURE=true
TRUST_PROXY=true

# --- WhatsApp Cloud API ---
WHATSAPP_PROVIDER=cloudapi
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_GRAPH_API_VERSION=v25.0
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# --- Administrador inicial (seed) ---
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Empresa (valores iniciales del seed) ---
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true

# --- Horario laboral / alertas ---
ENABLE_AFTER_HOURS_AUTO_REPLY=false
BUSINESS_HOURS_TIMEZONE=America/Costa_Rica
AFTER_HOURS_REPLY_COOLDOWN_HOURS=12
URGENT_AFTER_HOURS_EMAIL_ENABLED=false
URGENT_AFTER_HOURS_EMAIL_TO=
URGENT_AFTER_HOURS_EMAIL_COOLDOWN_MINUTES=30

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Dropbox ---
DROPBOX_STORAGE_ENABLED=false
DROPBOX_STORAGE_MODE=env
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_SYNC_RETRY_INTERVAL_MINUTES=5

# --- Otros ---
ENCRYPTION_KEY=
SENTRY_DSN=
LOG_LEVEL=info
