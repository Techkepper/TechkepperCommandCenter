# =============================================================================
# Docker Compose — copie este archivo como .env en la raíz del proyecto.
# No commitee el .env real: contiene secretos y credenciales.
# =============================================================================

# --- Base de datos ---
# MySQL local en Docker (comportamiento actual):
#   COMPOSE_PROFILES=local-db
#   DB_HOST se omite o queda en "mysql"
#
# MySQL remoto (Site4Now, MySQL 8.x, etc.):
#   Comente o elimine COMPOSE_PROFILES=local-db
#   y configure DATABASE_URL o DB_HOST/DB_NAME/DB_USER/DB_PASS.
COMPOSE_PROFILES=local-db

# MySQL remoto — connection string Node (Site4Now):
# DATABASE_URL=mysql://aa7e7f_command:YOUR_DB_PASSWORD@MYSQL5044.site4now.net:3306/db_aa7e7f_command
# DB_SSL=true
# Site4Now y otros hostings usan certificado autofirmado; deje en false:
# DB_SSL_REJECT_UNAUTHORIZED=false
#
# O variables separadas:
# DB_HOST=MYSQL5044.site4now.net
# DB_PORT=3306
# DB_NAME=db_aa7e7f_command
# DB_USER=aa7e7f_command
# DB_PASS=YOUR_DB_PASSWORD
# DB_SSL=true
DATABASE_URL=

# --- MySQL / MariaDB local (solo con COMPOSE_PROFILES=local-db) ---
MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.11
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=techkepper_command_center
MYSQL_PORT=3306
TZ=America/Costa_Rica

# --- Puertos expuestos en el host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
FRONTEND_SSL_PORT=3001

# --- URLs y proxy ---
BACKEND_URL=http://localhost
# URL pública del backend (dominio, ngrok, etc.) para webhooks de Meta y OAuth Dropbox.
BACKEND_PUBLIC_URL=
# Vacío = el frontend llama al mismo host (nginx en Docker). Útil en desarrollo local.
VITE_BACKEND_URL=
# Puerto por el que el navegador alcanza /public (medios). Debe coincidir con BACKEND_PORT.
PROXY_PORT=8080
FRONTEND_URL=http://localhost:3000
FRONTEND_SERVER_NAME=localhost
# Orígenes extra permitidos por CORS (separados por coma).
CORS_ALLOWED_ORIGINS=

# --- JWT / cookies ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=techkepper-command-center
JWT_AUDIENCE=techkepper-web
COOKIE_SECURE=false
TRUST_PROXY=false

# --- WhatsApp Cloud API ---
WHATSAPP_PROVIDER=cloudapi
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# ID de la WhatsApp Business Account (WABA). Meta > WhatsApp > API Setup.
# Necesario para suscribir la app a la WABA al iniciar; sin esto Meta puede no entregar mensajes.
META_WHATSAPP_WABA_ID=
META_WHATSAPP_GRAPH_API_VERSION=v25.0
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# --- Administrador inicial (seed) ---
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Empresa (valores iniciales del seed) ---
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true

# --- Horario laboral / respuesta automática ---
ENABLE_AFTER_HOURS_AUTO_REPLY=false
BUSINESS_HOURS_TIMEZONE=America/Costa_Rica
AFTER_HOURS_REPLY_COOLDOWN_HOURS=12
URGENT_AFTER_HOURS_EMAIL_ENABLED=false
URGENT_AFTER_HOURS_EMAIL_TO=
URGENT_AFTER_HOURS_EMAIL_COOLDOWN_MINUTES=30

# --- SMTP (alertas urgentes fuera de horario) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Nombre visible del remitente. Si no incluye @, se usa SMTP_USER como dirección.
SMTP_FROM=

# --- Dropbox (documentos inteligentes, solo servidor) ---
DROPBOX_STORAGE_ENABLED=false
DROPBOX_STORAGE_MODE=env
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_REDIRECT_URI=http://localhost:8080/dropbox/oauth/callback
DROPBOX_SYNC_RETRY_INTERVAL_MINUTES=5

# --- Cifrado / observabilidad ---
# Clave para cifrado reversible (p. ej. tokens). Mínimo 32 caracteres aleatorios.
ENCRYPTION_KEY=
SENTRY_DSN=
LOG_LEVEL=info

# --- Almacenamiento local de documentos (opcional) ---
# SMART_DOCUMENTS_STORAGE_PATH=
