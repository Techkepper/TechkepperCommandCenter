MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.11
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
TZ=America/Guatemala

BACKEND_PORT=8080
BACKEND_URL=http://localhost
BACKEND_PUBLIC_URL=http://localhost:8080
# URL pública del backend (ngrok) solo para webhooks de Meta. No usarla en el navegador.
VITE_BACKEND_URL=
# Puerto público por el que el navegador alcanza el backend para servir /public
# (imágenes, audios, etc.). DEBE coincidir con BACKEND_PORT.
PROXY_PORT=8080
FRONTEND_PORT=3000
FRONTEND_SSL_PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
FRONTEND_SERVER_NAME=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
COOKIE_SECURE=false
TRUST_PROXY=false
WHATSAPP_PROVIDER=cloudapi
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# ID de la WhatsApp Business Account (WABA). Se ve en Meta > WhatsApp > API Setup.
# Necesario para suscribir la app a la WABA automáticamente al iniciar (subscribed_apps);
# sin esta suscripción Meta no entrega los mensajes entrantes.
META_WHATSAPP_WABA_ID=
META_WHATSAPP_GRAPH_API_VERSION=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

INITIAL_ADMIN_NAME=Administrador Techkepper
INITIAL_ADMIN_EMAIL=admin@your-company-domain.example
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-12-character-password

COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true
ENABLE_AFTER_HOURS_AUTO_REPLY=false
BUSINESS_HOURS_TIMEZONE=America/Costa_Rica
AFTER_HOURS_REPLY_COOLDOWN_HOURS=12

# External document storage: Dropbox App Folder, configured server-side only.
DROPBOX_STORAGE_ENABLED=false
DROPBOX_STORAGE_MODE=env
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_REDIRECT_URI=http://localhost:8081/dropbox/oauth/callback
DROPBOX_SYNC_RETRY_INTERVAL_MINUTES=5

# General reversible-encryption key. Dropbox env mode does not persist its token.
ENCRYPTION_KEY=replace-with-a-random-32-character-secret
