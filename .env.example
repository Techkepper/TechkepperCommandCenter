MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.11
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
TZ=America/Guatemala

BACKEND_PORT=8080
BACKEND_URL=http://localhost
BACKEND_PUBLIC_URL=http://localhost:8080
PROXY_PORT=8080
FRONTEND_PORT=3000
FRONTEND_SSL_PORT=3001
FRONTEND_URL=http://localhost:3000
FRONTEND_SERVER_NAME=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
COOKIE_SECURE=false
TRUST_PROXY=false
WHATSAPP_PROVIDER=wwebjs
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_BIN=/usr/bin/chromium
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-accelerated-2d-canvas --no-first-run --no-zygote --disable-gpu

INITIAL_ADMIN_NAME=Administrador Techkepper
INITIAL_ADMIN_EMAIL=admin@your-company-domain.example
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-12-character-password

COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true
