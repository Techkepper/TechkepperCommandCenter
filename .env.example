# =============================================================================
# Docker Compose — copie este archivo como .env en la raíz del proyecto.
# No commitee el .env real: contiene secretos y credenciales.
# =============================================================================

# --- Perfil Docker ---
# local-db = levanta MySQL en contenedor. Sin perfil = MySQL remoto.
# COMPOSE_PROFILES=local-db

# --- Base de datos ---
# Remoto (Site4Now / MySQL 8.x):
# DATABASE_URL=mysql://aa7e7f_command:YOUR_DB_PASSWORD@MYSQL5044.site4now.net:3306/db_aa7e7f_command
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
#
# O variables separadas:
# DB_HOST=MYSQL5044.site4now.net
# DB_PORT=3306
# DB_NAME=db_aa7e7f_command
# DB_USER=aa7e7f_command
# DB_PASS=YOUR_DB_PASSWORD
# DB_SSL=true
DATABASE_URL=

# Local Docker (solo con COMPOSE_PROFILES=local-db):
MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.11
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=techkepper_command_center
MYSQL_PORT=3306
TZ=America/Costa_Rica

# --- URLs (desarrollo local) ---
# Copie .env.production.example → .env.production para Heroku (no use localhost en prod).
# Apps Heroku (CLI): api-command-center / web-command-center
PUBLIC_BACKEND_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002

# --- Puertos Docker (solo mapeo host ← contenedor) ---
BACKEND_PORT=8081
FRONTEND_PORT=3002
FRONTEND_SSL_PORT=3003
FRONTEND_SERVER_NAME=localhost

# --- Frontend (Docker inyecta VITE_* al build en runtime) ---
# Vacío = el navegador usa el mismo host (/api vía nginx). Para dev directo use localhost:
VITE_BACKEND_URL=http://localhost:8081
# Solo para npm run dev sin Docker (debe coincidir con PUBLIC_BACKEND_URL):
# VITE_DEV_BACKEND_URL=http://localhost:8081

# --- Meta / webhooks (opcional: sustituya PUBLIC_BACKEND_URL por ngrok) ---
# PUBLIC_BACKEND_URL=https://xxxx.ngrok-free.app

# --- JWT / cookies ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=techkepper-command-center
JWT_AUDIENCE=techkepper-web
COOKIE_SECURE=false
TRUST_PROXY=false
# Use /api/auth cuando el frontend acceda al backend mediante el proxy /api.
REFRESH_COOKIE_PATH=/auth

# --- WhatsApp Cloud API ---
WHATSAPP_PROVIDER=cloudapi
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# ID de la WhatsApp Business Account (WABA). Meta > WhatsApp > API Setup.
# Necesario para suscribir la app a la WABA al iniciar; sin esto Meta puede no entregar mensajes.
META_WHATSAPP_WABA_ID=
META_WHATSAPP_GRAPH_API_VERSION=v25.0
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# --- Administrador inicial (seed) ---
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Empresa (valores iniciales del seed) ---
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
DEFAULT_THEME=dark
ENABLE_ASSIGNMENT_AUTO_MESSAGE=true

# --- Horario laboral / alertas ---
ENABLE_AFTER_HOURS_AUTO_REPLY=false
BUSINESS_HOURS_TIMEZONE=America/Costa_Rica
AFTER_HOURS_REPLY_COOLDOWN_HOURS=12
URGENT_AFTER_HOURS_EMAIL_ENABLED=false
URGENT_AFTER_HOURS_EMAIL_TO=
URGENT_AFTER_HOURS_EMAIL_COOLDOWN_MINUTES=30

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Nombre visible del remitente. Si no incluye @, se usa SMTP_USER como dirección.
SMTP_FROM=

# --- Dropbox ---
DROPBOX_STORAGE_ENABLED=false
DROPBOX_STORAGE_MODE=env
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_SYNC_RETRY_INTERVAL_MINUTES=5

# --- Otros ---
ENCRYPTION_KEY=
SENTRY_DSN=
LOG_LEVEL=info
# SMART_DOCUMENTS_STORAGE_PATH=
