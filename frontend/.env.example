# =============================================================================
# Desarrollo local del frontend — copie como frontend/.env
# En Docker, VITE_* se inyecta desde el .env de la raíz vía docker-compose.
# =============================================================================

# Vacío = el frontend llama al mismo host (proxy de Vite en dev, nginx en Docker).
VITE_BACKEND_URL=

# Solo para `npm run dev` sin Docker: URL del backend local.
VITE_DEV_BACKEND_URL=http://localhost:8080

# Horas para cierre automático de tickets (opcional).
VITE_HOURS_CLOSE_TICKETS_AUTO=
